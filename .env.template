# Template for the local root .env file.
#
# Usage:
#   cp .env.template .env
#   # replace the placeholders below with your own values
#   source .env
#
# .env is git-ignored. Never commit real values, and never paste them into
# issues, chats, or logs. Only this template is tracked.
#
# The same two values are used as GitHub Actions repository secrets by
# .github/workflows/bob-pr-review.yml (see CONTRIBUTING.md, "Required repository secrets").

# Bob Shell API key, scope "Inference".
# Create it at: https://bob.ibm.com/docs/ide/account/api-keys
# (shown only once when created)
export BOBSHELL_API_KEY="<your-bob-shell-api-key>"

# GitHub fine-grained personal access token used by Bob's GitHub MCP server.
# Repository permissions: Contents = Read, Pull requests = Read and write, Metadata = Read.
export BOB_GITHUB_TOKEN="<your-github-token>"
