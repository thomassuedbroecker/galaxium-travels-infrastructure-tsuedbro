# =============================================================================
# IBM Code Engine — OAuth2 deployment environment
# Companion file for:  deploy-stack-oauth2.sh
# =============================================================================
#
# USAGE
# -----
#   cp deploy.env.oauth2.template deploy.env.oauth2
#   # Edit every line marked  <-- REQUIRED
#   bash deploy-stack-oauth2.sh
#
# deploy-stack-oauth2.sh always exports STACK_AUTH_MODE=oauth2, so that
# variable is informational here; you cannot accidentally run basic auth
# from that entrypoint.
#
# To point at a different file:
#   ENV_FILE=/path/to/my.env bash deploy-stack-oauth2.sh
#
# LEGEND
# ------
#   REQUIRED       you must fill this in before running
#   DEFAULT OK     the pre-filled value is a reasonable starting point
#   CONDITIONAL    only read when a specific mode is active (see comment)
#   OPTIONAL       leave empty for the default behaviour described in the comment
#   NOT USED       never read in oauth2 mode; kept for completeness only
# =============================================================================


# =============================================================================
# IBM CLOUD TARGET                                          (all REQUIRED/DEFAULT OK)
# =============================================================================

# REQUIRED – Non-interactive automation: set your IBM Cloud API key.
# OPTIONAL – Leave empty if you have already run 'ibmcloud login' interactively.
IBM_CLOUD_API_KEY=

# DEFAULT OK – Change only when targeting a different IBM Cloud region.
IBM_CLOUD_REGION=us-south

# DEFAULT OK – Change to the resource group that owns your Code Engine project.
IBM_CLOUD_RESOURCE_GROUP=default

# REQUIRED – Name of the Code Engine project to create or reuse.
CE_PROJECT_NAME=galaxium-travels-oauth2

# OPTIONAL – Tag applied when the project is first created.  Leave empty to skip.
CE_PROJECT_TAG=galaxium

# DEFAULT OK – 'public' exposes the project on the public internet.
CE_ENDPOINT=public


# =============================================================================
# STACK AUTH MODE                                           (informational; always oauth2)
# =============================================================================

# deploy-stack-oauth2.sh enforces oauth2 by exporting STACK_AUTH_MODE before
# any script runs, so the value here is overridden automatically.
# Keeping it set makes the file self-documenting.
STACK_AUTH_MODE=oauth2

# ── What oauth2 mode means for the frontend ──────────────────────────────────
# When STACK_AUTH_MODE=oauth2, script 04-deploy-services.sh automatically
# deploys BOTH web frontends in oauth2 mode:
#
#   REST Web UI  (galaxium-booking-web-app, port 8083)
#     receives:  BACKEND_AUTH_MODE=oauth2
#                FRONTEND_AUTH_REQUIRED=<see below>
#                OIDC_TOKEN_URL   (derived from KEYCLOAK_REALM at deploy time)
#                OIDC_CLIENT_ID   (from this file)
#                OIDC_SCOPE       (from this file)
#     secret:    OIDC_CLIENT_SECRET (from WEB_APP_SECRET_NAME)
#
#   MCP Web UI   (galaxium-booking-web-app-mcp, port 8085)
#     receives:  BACKEND_AUTH_MODE=oauth2
#                FRONTEND_AUTH_REQUIRED=<see below>
#                OIDC_TOKEN_URL   (derived from KEYCLOAK_REALM at deploy time)
#                OIDC_CLIENT_ID   (from this file)
#                OIDC_SCOPE       (from this file)
#     secret:    OIDC_CLIENT_SECRET (from WEB_APP_SECRET_NAME)
#
# There is no separate "frontend source" to select — the same application code
# is used for both auth modes.  The auth behaviour is driven entirely by the
# env vars listed above, which are injected via Code Engine configmaps and
# secrets at deployment time.
# ─────────────────────────────────────────────────────────────────────────────

# OPTIONAL – Whether the web UIs show a browser login screen.
# Leave empty to use the oauth2 default: true (login required).
# Set to 'false' only when you want guest-mode browsing with an oauth2 backend
# (e.g. the UI calls the API on behalf of a machine identity, not a human user).
FRONTEND_AUTH_REQUIRED=


# =============================================================================
# DEPLOYMENT ARTIFACT MODE                                  (REQUIRED – choose one)
# =============================================================================

# REQUIRED – How Code Engine obtains service images.
#   source_build   – Code Engine builds images from source (default; simplest path).
#   prebuilt_images – You build images locally, push to IBM Cloud Container Registry,
#                    Code Engine deploys from those image references.
DEPLOY_ARTIFACT_MODE=source_build


# =============================================================================
# BUILD SOURCE                           (CONDITIONAL: source_build mode only)
# =============================================================================

# OPTIONAL – Leave empty to build from the current local repository checkout.
# Set to a Git URL (https:// or git@) to have Code Engine pull from a repository.
BUILD_SOURCE=

# OPTIONAL – Git commit/branch/tag. Only used when BUILD_SOURCE is a Git URL.
BUILD_COMMIT=


# =============================================================================
# PREBUILT IMAGE SETTINGS               (CONDITIONAL: prebuilt_images mode only)
# =============================================================================
# All variables in this block are ignored when DEPLOY_ARTIFACT_MODE=source_build.

# REQUIRED if prebuilt_images – IBM Cloud Container Registry region.
ICR_REGION=us-south

# REQUIRED if prebuilt_images – Registry host, e.g. us.icr.io.
ICR_REGISTRY=us.icr.io

# REQUIRED if prebuilt_images – Namespace inside the registry where images are pushed.
ICR_NAMESPACE=change-me

# DEFAULT OK if prebuilt_images – Code Engine secret name for pulling private images.
ICR_REGISTRY_SECRET_NAME=galaxium-icr-access

# DEFAULT OK if prebuilt_images – Registry username; 'iamapikey' is correct for IBM Cloud.
ICR_REGISTRY_USERNAME=iamapikey

# OPTIONAL if prebuilt_images – Registry password.
# Leave empty to reuse IBM_CLOUD_API_KEY as the password.
ICR_REGISTRY_PASSWORD=

# DEFAULT OK if prebuilt_images – Container client used for local image builds.
# Supported: docker, podman
CONTAINER_CLIENT=docker

# DEFAULT OK if prebuilt_images – Target platform for local image builds.
# Keep linux/amd64 unless you have validated another architecture with Code Engine.
CONTAINER_PLATFORM=linux/amd64

# DEFAULT OK if prebuilt_images – Image tag applied to all pushed Galaxium images.
IMAGE_TAG=latest

# DEFAULT OK if prebuilt_images – Repository names inside ICR_NAMESPACE.
HR_IMAGE_REPOSITORY=galaxium-hr-api
BOOKING_API_IMAGE_REPOSITORY=galaxium-booking-api
MCP_IMAGE_REPOSITORY=galaxium-booking-mcp
WEB_APP_IMAGE_REPOSITORY=galaxium-web-ui
WEB_APP_MCP_IMAGE_REPOSITORY=galaxium-web-ui-mcp


# =============================================================================
# APPLICATION NAMES                                         (DEFAULT OK)
# =============================================================================
# Code Engine application names.  The defaults are unique within a project.
# Change only when you deploy multiple stacks into the same project.

KEYCLOAK_APP_NAME=galaxium-keycloak
HR_APP_NAME=galaxium-hr-api
BOOKING_API_APP_NAME=galaxium-booking-api
MCP_APP_NAME=galaxium-booking-mcp
WEB_APP_NAME=galaxium-web-ui
WEB_APP_MCP_APP_NAME=galaxium-web-ui-mcp


# =============================================================================
# KEYCLOAK AND OIDC SETTINGS                                (REQUIRED for oauth2)
# =============================================================================
#
# Variable → service mapping:
#
#   KEYCLOAK_REALM      → Keycloak (realm import), Booking API, MCP server,
#                         both web UIs (token URL is derived as
#                         <keycloak_url>/realms/<KEYCLOAK_REALM>/protocol/openid-connect/token)
#   OIDC_AUDIENCE       → Booking API configmap, MCP server configmap
#                         (validated in the JWT 'aud' claim)
#   OIDC_CLIENT_ID      → REST Web UI configmap, MCP Web UI configmap
#   OIDC_SCOPE          → REST Web UI configmap, MCP Web UI configmap
#   KEYCLOAK_BASE_URL_OVERRIDE → controls whether Keycloak is deployed in-project
#                                or an external instance is used

# DEFAULT OK – Keycloak realm name imported from local-container/keycloak/realm/.
KEYCLOAK_REALM=galaxium

# DEFAULT OK – The JWT 'aud' claim validated by the Booking API and MCP server.
OIDC_AUDIENCE=booking-api

# DEFAULT OK – OAuth2 client ID used by both web UIs when requesting tokens.
OIDC_CLIENT_ID=web-app-proxy

# DEFAULT OK – Scopes requested by both web UIs.
OIDC_SCOPE="openid profile email"

# OPTIONAL – Override to connect to an existing external Keycloak instead of
# deploying a new one inside this Code Engine project.
# Leave empty (default) to deploy Keycloak in the same project.
# When set, scripts 03-deploy-keycloak.sh and 05-sync-keycloak-client.sh are skipped.
# Example: KEYCLOAK_BASE_URL_OVERRIDE=https://keycloak.example.com
KEYCLOAK_BASE_URL_OVERRIDE=


# =============================================================================
# SECRETS                                                   (all REQUIRED)
# =============================================================================

# REQUIRED – Keycloak admin credentials.  Used by scripts 02, 03, and 05.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# REQUIRED – OIDC client secret for the web-app-proxy client.
#            Must match the value configured in the Keycloak realm.
OIDC_CLIENT_SECRET=change-me

# REQUIRED – Random secret key used by the Flask web UIs for session signing.
#            Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-value

# NOT USED in oauth2 mode – Basic Auth credentials are never injected into
# services when STACK_AUTH_MODE=oauth2.  Leave these empty.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=


# =============================================================================
# CODE ENGINE SECRET AND CONFIGMAP NAMES                    (DEFAULT OK)
# =============================================================================
# These are the names of Code Engine objects created or updated by the scripts.
# Change only when you need to avoid collisions with an existing deployment.

# Used in oauth2 mode only (Keycloak realm import).
KEYCLOAK_REALM_CONFIGMAP_NAME=galaxium-keycloak-realm
BOOKING_API_CONFIGMAP_NAME=galaxium-booking-api-config
MCP_CONFIGMAP_NAME=galaxium-booking-mcp-config
WEB_APP_CONFIGMAP_NAME=galaxium-web-ui-config
WEB_APP_MCP_CONFIGMAP_NAME=galaxium-web-ui-mcp-config
# Used in oauth2 mode only (Keycloak admin credentials).
KEYCLOAK_ADMIN_SECRET_NAME=galaxium-keycloak-admin
WEB_APP_SECRET_NAME=galaxium-web-ui-secrets

# NOT USED in oauth2 mode – The basic-auth secret is never created or attached
# to any service when STACK_AUTH_MODE=oauth2.
# Kept here so the file is structurally complete alongside deploy.env.template.
BASIC_AUTH_SECRET_NAME=galaxium-basic-auth


# =============================================================================
# OPTIONAL PERSISTENT DATA STORES
# =============================================================================
# Leave commented out to use ephemeral (in-container) storage.
# Keycloak and HR data are lost on container restart without these.

# KEYCLOAK_DATA_STORE_NAME=
# HR_DATA_STORE_NAME=


# =============================================================================
# RUNTIME SIZING                                            (DEFAULT OK)
# =============================================================================

KEYCLOAK_CPU=1
KEYCLOAK_MEMORY=2G
SERVICE_CPU=1
SERVICE_MEMORY=1G
WEB_CPU=1
WEB_MEMORY=1G

# MCP streaming timeout in seconds for the MCP web UI service layer.
MCP_TIMEOUT_SECONDS=10


# =============================================================================
# SCALING                                                   (DEFAULT OK)
# =============================================================================
# Keycloak must stay at min-scale=1 so it is always reachable by other services.
# Service and web UIs can scale to zero to save cost when idle.

KEYCLOAK_MIN_SCALE=1
KEYCLOAK_MAX_SCALE=1
SERVICE_MIN_SCALE=0
SERVICE_MAX_SCALE=2
WEB_MIN_SCALE=0
WEB_MAX_SCALE=2
