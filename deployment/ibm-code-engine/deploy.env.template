# This deployment package uses bash scripts plus the IBM Cloud CLI.
# It does not use Terraform.
# Set IBM_CLOUD_API_KEY for non-interactive automation, or leave it empty and
# log in with 'ibmcloud login' before running the scripts.

# IBM Cloud target
IBM_CLOUD_API_KEY=
IBM_CLOUD_REGION=us-south
IBM_CLOUD_RESOURCE_GROUP=default
CE_PROJECT_NAME=galaxium-travels
CE_PROJECT_TAG=galaxium
CE_ENDPOINT=public

# Stack auth mode
# Supported values: oauth2, basic
STACK_AUTH_MODE=oauth2
# Leave empty to use the mode default.
# oauth2 -> true, basic -> false
FRONTEND_AUTH_REQUIRED=

# Deployment artifact mode
# source_build: Code Engine builds from source with --build-source
# prebuilt_images: build local container images, push them to IBM Cloud Container Registry, then deploy from --image
DEPLOY_ARTIFACT_MODE=source_build

# Build source
# Used only when DEPLOY_ARTIFACT_MODE=source_build.
# Leave BUILD_SOURCE empty to build from the current local repository checkout.
# Set BUILD_SOURCE to a Git URL if you want Code Engine to pull from a repository.
BUILD_SOURCE=
# Optional when BUILD_SOURCE is a Git URL.
BUILD_COMMIT=

# Prebuilt image workflow
# Used only when DEPLOY_ARTIFACT_MODE=prebuilt_images.
# This workflow builds and pushes the five Galaxium service images.
# Keycloak still uses the public quay.io image by default.
# IBM Cloud Container Registry requires supported image formats. Keep the default
# platform unless you have validated another image architecture with Code Engine.
ICR_REGION=us-south
ICR_REGISTRY=us.icr.io
ICR_NAMESPACE=change-me
ICR_REGISTRY_SECRET_NAME=galaxium-icr-access
ICR_REGISTRY_USERNAME=iamapikey
# Leave empty to reuse IBM_CLOUD_API_KEY.
ICR_REGISTRY_PASSWORD=
CONTAINER_CLIENT=docker
CONTAINER_PLATFORM=linux/amd64
IMAGE_TAG=latest
HR_IMAGE_REPOSITORY=galaxium-hr-api
BOOKING_API_IMAGE_REPOSITORY=galaxium-booking-api
MCP_IMAGE_REPOSITORY=galaxium-booking-mcp
WEB_APP_IMAGE_REPOSITORY=galaxium-web-ui
WEB_APP_MCP_IMAGE_REPOSITORY=galaxium-web-ui-mcp

# Application names
KEYCLOAK_APP_NAME=galaxium-keycloak
HR_APP_NAME=galaxium-hr-api
BOOKING_API_APP_NAME=galaxium-booking-api
MCP_APP_NAME=galaxium-booking-mcp
WEB_APP_NAME=galaxium-web-ui
WEB_APP_MCP_APP_NAME=galaxium-web-ui-mcp

# Shared auth settings
KEYCLOAK_REALM=galaxium
OIDC_AUDIENCE=booking-api
OIDC_CLIENT_ID=web-app-proxy
OIDC_SCOPE="openid profile email"
# Leave empty to deploy Keycloak in the same Code Engine project.
# Set only when you intentionally use an existing external Keycloak deployment.
KEYCLOAK_BASE_URL_OVERRIDE=
# Optional extra redirect targets or web origins can be handled later in
# scripts/05-sync-keycloak-client.sh after the public UI URLs are known.

# Secrets
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
FLASK_SECRET_KEY=replace-with-a-long-random-value
BASIC_AUTH_USERNAME=demo-basic-user
BASIC_AUTH_PASSWORD=change-me

# Code Engine secret and configmap names
KEYCLOAK_REALM_CONFIGMAP_NAME=galaxium-keycloak-realm
KEYCLOAK_ADMIN_SECRET_NAME=galaxium-keycloak-admin
WEB_APP_SECRET_NAME=galaxium-web-ui-secrets
BASIC_AUTH_SECRET_NAME=galaxium-basic-auth

# Optional persistent data stores
# KEYCLOAK_DATA_STORE_NAME=
# HR_DATA_STORE_NAME=

# Runtime sizing
KEYCLOAK_CPU=1
KEYCLOAK_MEMORY=2G
SERVICE_CPU=1
SERVICE_MEMORY=1G
WEB_CPU=1
WEB_MEMORY=1G
MCP_TIMEOUT_SECONDS=10

# Scaling
KEYCLOAK_MIN_SCALE=1
KEYCLOAK_MAX_SCALE=1
SERVICE_MIN_SCALE=0
SERVICE_MAX_SCALE=2
WEB_MIN_SCALE=0
WEB_MAX_SCALE=2
