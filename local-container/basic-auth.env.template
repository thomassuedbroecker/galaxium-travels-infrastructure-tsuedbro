# Copy this file to basic-auth.env before starting the Basic Auth compose variant.
#
# Usage:
#   cp local-container/basic-auth.env.template local-container/basic-auth.env
#   docker compose --env-file local-container/basic-auth.env \
#     -f local-container/docker_compose.basic-auth.yaml up --build -d
#
# These values are also loaded automatically by the Basic Auth verification scripts
# and the Basic Auth MCP Inspector helper when local-container/basic-auth.env exists.

BASIC_AUTH_USERNAME=demo-basic-user
BASIC_AUTH_PASSWORD=demo-basic-password
