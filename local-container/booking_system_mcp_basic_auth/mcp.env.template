# Settings for the Basic Auth MCP variant.
#
# Usage:
#   cp local-container/booking_system_mcp_basic_auth/mcp.env.template local-container/booking_system_mcp_basic_auth/mcp.env
#
# start.sh and verify.sh load mcp.env automatically when it exists.
# Change the demo credentials before exposing the server outside your machine.
# Enter the same username and password in the watsonx Orchestrate connection.

# Host port that publishes the MCP server (container port is always 8084).
export MCP_HOST_PORT=8084

# Shared credentials the MCP server accepts.
export BASIC_AUTH_USERNAME=demo-basic-user
export BASIC_AUTH_PASSWORD=demo-basic-password
