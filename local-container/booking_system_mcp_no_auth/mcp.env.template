# Optional overrides for the no-auth MCP variant.
#
# Usage:
#   cp local-container/booking_system_mcp_no_auth/mcp.env.template local-container/booking_system_mcp_no_auth/mcp.env
#
# start.sh and verify.sh load mcp.env automatically when it exists.

# Host port that publishes the MCP server (container port is always 8084).
export MCP_HOST_PORT=8084
