# Settings for the OAuth 2.0 MCP variant (client_credentials / authorization_code, no implicit flow).
#
# Usage:
#   cp local-container/booking_system_mcp_oauth2_no_implicit_flow/mcp.env.template \
#      local-container/booking_system_mcp_oauth2_no_implicit_flow/mcp.env
#
# start.sh, verify.sh and get-token.sh load mcp.env automatically when it exists.

# Host ports (container ports are 8084 for MCP and 8080 for Keycloak).
export MCP_HOST_PORT=8084
export KEYCLOAK_HOST_PORT=8086

# Public URLs: the URLs MCP clients (watsonx Orchestrate, Inspector, agents) use.
# Keycloak's issuer and the MCP OAuth metadata are built from these values,
# so they must match what the client actually calls.
export KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8086
export MCP_PUBLIC_BASE_URL=http://localhost:8084

# Folder with the Keycloak realm export(s) to import (absolute path recommended).
# Default: local-container/keycloak/realm. See local-container/keycloak/README.md.
# export KEYCLOAK_REALM_DIR=/absolute/path/to/your/realm-folder

# Client used for the client_credentials grant (realm demo client; its tokens
# carry the booking-api audience the MCP server requires).
export OIDC_CLIENT_ID=web-app-proxy
export OIDC_CLIENT_SECRET=web-app-proxy-secret
